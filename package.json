{
  "name": "dsh-vision-reader",
  "version": "0.2.0",
  "description": "Vision media reading for DeepSeek Harness: upload images/videos and analyze them through your own OpenAI-compatible VL provider, by an agent tool. Appears in Settings > Plugins and runs persistently.",
  "license": "MIT",
  "author": "easonz1989 <easonz1989@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/easonz1989/dsh-vision-reader.git"
  },
  "homepage": "https://github.com/easonz1989/dsh-vision-reader#readme",
  "bugs": {
    "url": "https://github.com/easonz1989/dsh-vision-reader/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-web-react": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^20.0.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.4.0",
    "unrun": "^0.2.26"
  },
  "scripts": {
    "build": "tsdown && tsc --emitDeclarationOnly --noEmit false && node scripts/check-client-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "keywords": [
    "dsh",
    "plugin",
    "vision",
    "vl",
    "multimodal",
    "image",
    "video"
  ]
}
